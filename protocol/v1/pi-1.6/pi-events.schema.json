{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hush:protocol:pi-events:1",
  "$defs": {
    "successEnvelope": {
      "type":"object","required":["type","id","method","ok","result"],"additionalProperties":false,
      "properties":{"type":{"const":"response"},"id":{"type":"string","pattern":"^[A-Za-z0-9_-]{1,160}$"},"method":{"enum":["ext.piEvents.open","ext.piEvents.command","ext.piEvents.catalog"]},"ok":{"const":true},"result":{"type":"object"}}
    },
    "shortText": {"type":"string","minLength":1,"maxLength":4096},
    "threadId": {"type":"string","pattern":"^[1-9][0-9]{0,15}$"},
    "epoch": {"type":"string","pattern":"^[a-f0-9-]{36}$"},
    "thinking": {"enum":["off","minimal","low","medium","high","xhigh","max"]},
    "open": {
      "type":"object","required":["cwd"],"additionalProperties":false,
      "properties": {
        "cwd":{"$ref":"#/$defs/shortText"}, "threadId":{"$ref":"#/$defs/threadId"},
        "session":{"$ref":"#/$defs/shortText"}, "continue":{"const":true}, "fork":{"const":true},
        "provider":{"$ref":"#/$defs/shortText"}, "model":{"$ref":"#/$defs/shortText"},
        "thinking":{"$ref":"#/$defs/thinking"},
        "models":{"type":"array","minItems":1,"maxItems":64,"items":{"$ref":"#/$defs/shortText"}},
        "name":{"$ref":"#/$defs/shortText"},
        "systemPrompt":{"type":"string","maxLength":262144},
        "appendSystemPrompt":{"type":"string","maxLength":262144}
      },
      "not":{"anyOf":[{"required":["threadId","continue"]},{"required":["threadId","session"]},{"required":["session","continue"]}]},
      "dependentSchemas":{"fork":{"anyOf":[{"required":["threadId"]},{"required":["session"]},{"required":["continue"]}]}}
    },
    "catalog": {"type":"object","maxProperties":0},
    "catalogResult": {"type":"object","required":["models"],"additionalProperties":false,"properties":{"models":{"type":"array","items":{"type":"object","required":["provider","id","name","api","baseUrl","input","reasoning","cost","contextWindow","maxTokens"],"not":{"required":["headers"]}}}}},
    "command": {
      "type":"object","required":["type"],
      "properties":{"type":{"type":"string","minLength":1,"maxLength":160},"id":{"type":"string","maxLength":4096}}
    },
    "call": {
      "type":"object","required":["epoch","command"],"additionalProperties":false,
      "properties":{"epoch":{"$ref":"#/$defs/epoch"},"command":{"$ref":"#/$defs/command"}}
    },
    "header": {
      "type":"object","required":["type","version","id","timestamp","cwd"],"additionalProperties":false,
      "properties":{"type":{"const":"session"},"version":{"const":3},"id":{"$ref":"#/$defs/epoch"},"timestamp":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},"cwd":{"$ref":"#/$defs/shortText"},"parentSession":{"$ref":"#/$defs/shortText"}}
    },
    "ready": {
      "type":"object","required":["threadId","epoch","seq","header","services"],"additionalProperties":false,
      "properties":{"threadId":{"$ref":"#/$defs/threadId"},"epoch":{"$ref":"#/$defs/epoch"},"seq":{"const":0},"header":{"$ref":"#/$defs/header"},"services":{"type":"array","uniqueItems":true,"items":{"enum":["models","titles","resources","piSessions","images"]}}}
    },
    "response": {
      "type":"object","required":["type","command","success"],"additionalProperties":false,
      "properties":{"type":{"const":"response"},"command":{"type":"string","minLength":1,"maxLength":160},"id":{"type":"string","maxLength":4096},"success":{"type":"boolean"},"data":{},"error":{"type":"string","minLength":1}},
      "if":{"properties":{"success":{"const":true}}},"then":{"not":{"required":["error"]}},"else":{"required":["error"],"not":{"required":["data"]}}
    },
    "callResult": {
      "type":"object","required":["response"],"additionalProperties":false,
      "properties":{"response":{"$ref":"#/$defs/response"},"ready":{"$ref":"#/$defs/ready"}}
    },
    "message": {
      "type":"object","required":["role","content","timestamp"],
      "properties":{"role":{"enum":["system","user","assistant","toolResult"]},"timestamp":{"type":"number"}},
      "if":{"properties":{"role":{"const":"assistant"}}},
      "then":{"required":["stopReason","usage","provider","api","model"],"properties":{"stopReason":{"type":"string"},"usage":{"$ref":"#/$defs/usage"},"content":{"type":"array"}}}
    },
    "usage": {"type":"object","required":["input","output","cacheRead","cacheWrite","totalTokens","cost"],"properties":{"totalTokens":{"type":"number"},"cost":{"type":"object"}}},
    "retryAttempt": {"type":"integer","minimum":1,"maximum":9007199254740991},
    "event": {
      "type":"object","required":["type"],
      "properties":{"type":{"enum":["agent_start","agent_end","agent_settled","turn_start","turn_end","message_start","message_update","message_end","tool_execution_start","tool_execution_update","tool_execution_end","queue_update","thinking_level_changed","session_info_changed","compaction_start","compaction_end","auto_retry_start","auto_retry_end","summarization_retry_scheduled","summarization_retry_attempt_start","summarization_retry_finished"]}},
      "allOf":[
        {"if":{"properties":{"type":{"const":"agent_end"}}},"then":{"required":["messages","willRetry"],"properties":{"messages":{"type":"array","items":{"$ref":"#/$defs/message"}},"willRetry":{"type":"boolean"}}}},
        {"if":{"properties":{"type":{"const":"agent_settled"}}},"then":{"required":["aborted"],"properties":{"aborted":{"type":"boolean"}}}},
        {"if":{"properties":{"type":{"enum":["turn_end","message_start","message_end"]}}},"then":{"required":["message"],"properties":{"message":{"$ref":"#/$defs/message"}}}},
        {"if":{"properties":{"type":{"const":"turn_end"}}},"then":{"required":["toolResults"],"properties":{"toolResults":{"type":"array"}}}},
        {"if":{"properties":{"type":{"const":"message_update"}}},"then":{"required":["assistantMessageEvent","usage"],"not":{"anyOf":[{"required":["partial"]},{"required":["message"]}]},"properties":{"usage":{"$ref":"#/$defs/usage"},"assistantMessageEvent":{"type":"object","required":["type","contentIndex"],"not":{"required":["partial"]},"properties":{"type":{"enum":["text_start","text_delta","text_end","thinking_start","thinking_delta","thinking_end","toolcall_start","toolcall_delta","toolcall_end"]},"contentIndex":{"type":"integer","minimum":0}},"allOf":[{"if":{"properties":{"type":{"enum":["text_delta","thinking_delta","toolcall_delta"]}}},"then":{"required":["delta"],"properties":{"delta":{"type":"string"}}}},{"if":{"properties":{"type":{"enum":["text_end","thinking_end"]}}},"then":{"required":["content"],"properties":{"content":{"type":"string"}}}},{"if":{"properties":{"type":{"const":"toolcall_start"}}},"then":{"required":["id","toolName"],"properties":{"id":{"type":"string"},"toolName":{"type":"string"}}}},{"if":{"properties":{"type":{"const":"toolcall_end"}}},"then":{"required":["toolCall"],"properties":{"toolCall":{"type":"object"}}}}]}}}},
        {"if":{"properties":{"type":{"enum":["tool_execution_start","tool_execution_update","tool_execution_end"]}}},"then":{"required":["toolCallId","toolName"],"properties":{"toolCallId":{"type":"string"},"toolName":{"type":"string"}}}},
        {"if":{"properties":{"type":{"enum":["tool_execution_start","tool_execution_update"]}}},"then":{"required":["args"],"properties":{"args":{"type":"object"}}}},
        {"if":{"properties":{"type":{"const":"tool_execution_update"}}},"then":{"required":["partialResult"],"properties":{"partialResult":{"type":"object","required":["content"]}}}},
        {"if":{"properties":{"type":{"const":"tool_execution_end"}}},"then":{"required":["result","isError"],"properties":{"result":{"type":"object","required":["content"]},"isError":{"type":"boolean"},"durationMs":{"type":"number","minimum":0}}}},
        {"if":{"properties":{"type":{"const":"queue_update"}}},"then":{"required":["steering","followUp"],"properties":{"steering":{"type":"array","items":{"type":"string"}},"followUp":{"type":"array","items":{"type":"string"}}}}},
        {"if":{"properties":{"type":{"const":"thinking_level_changed"}}},"then":{"required":["level"],"properties":{"level":{"$ref":"#/$defs/thinking"}}}},
        {"if":{"properties":{"type":{"enum":["compaction_start","compaction_end","summarization_retry_attempt_start"]}}},"then":{"required":["reason"],"properties":{"reason":{"enum":["manual","threshold","overflow"]}}}},
        {"if":{"properties":{"type":{"const":"compaction_end"}}},"then":{"required":["aborted","willRetry"],"properties":{"aborted":{"type":"boolean"},"willRetry":{"type":"boolean"},"errorMessage":{"type":"string"},"result":{"type":"object","required":["summary","firstKeptEntryId","tokensBefore","estimatedTokensAfter"],"properties":{"summary":{"type":"string"},"firstKeptEntryId":{"$ref":"#/$defs/threadId"},"tokensBefore":{"type":"number","minimum":0},"estimatedTokensAfter":{"type":"number","minimum":0}}}}}},
        {"if":{"properties":{"type":{"const":"session_info_changed"}}},"then":{"properties":{"name":{"type":"string"}}}},
        {"if":{"properties":{"type":{"const":"summarization_retry_attempt_start"}}},"then":{"required":["source"],"properties":{"source":{"const":"compaction"}}}},
        {"if":{"properties":{"type":{"enum":["auto_retry_start","summarization_retry_scheduled"]}}},"then":{"required":["attempt","maxAttempts","delayMs","errorMessage"],"properties":{"attempt":{"$ref":"#/$defs/retryAttempt"},"maxAttempts":{"$ref":"#/$defs/retryAttempt"},"delayMs":{"type":"number","minimum":0},"errorMessage":{"type":"string"}}}},
        {"if":{"properties":{"type":{"const":"auto_retry_end"}}},"then":{"required":["success","attempt"],"properties":{"success":{"type":"boolean"},"attempt":{"$ref":"#/$defs/retryAttempt"},"finalError":{"type":"string"}}}}
      ]
    },
    "frame": {
      "type":"object","required":["type","threadId","epoch","seq","event"],"additionalProperties":false,
      "properties":{"type":{"const":"pi_event"},"threadId":{"$ref":"#/$defs/threadId"},"epoch":{"$ref":"#/$defs/epoch"},"seq":{"type":"integer","minimum":1,"maximum":9007199254740991},"event":{"$ref":"#/$defs/event"}}
    },
    "end": {
      "type":"object","required":["type","threadId","epoch","reason"],"additionalProperties":false,
      "properties":{"type":{"const":"pi_end"},"threadId":{"$ref":"#/$defs/threadId"},"epoch":{"$ref":"#/$defs/epoch"},"reason":{"enum":["overflow","source_failed"]}}
    }
  }
}
